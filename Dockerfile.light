# Imagem enxuta para VMs de 1 GB (Oracle E2.1.Micro).
# Diferença para o Dockerfile normal: SEM Playwright/Chromium (~114 MB + 300-500 MB
# de RAM quando abre). O auto-apply fica indisponível, e a app cai no fallback de
# mandar o CV adaptado no Telegram para você aplicar manualmente — que é exatamente
# o fluxo do modo `review`.
FROM python:3.12-slim

# deps de sistema: apenas WeasyPrint (geração de PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
    libffi-dev shared-mime-info fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Camada 1: dependências em cache (não refaz a cada mudança de código)
COPY pyproject.toml README.md ./
RUN mkdir -p autoapply && touch autoapply/__init__.py \
    && pip install --no-cache-dir ".[pdf]"

# Camada 2: o código
COPY autoapply ./autoapply
RUN pip install --no-cache-dir --no-deps --force-reinstall .

WORKDIR /data
ENTRYPOINT ["autoapply", "-c", "/data/config.yaml"]
CMD ["run"]
